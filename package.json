{
  "name": "prelevement-deau-data",
  "type": "module",
  "scripts": {
    "start": "node api.js",
    "start-dev": "nodemon --watch './**/*.js' --exec 'node api.js'",
    "start:worker": "node worker.js",
    "import-bvtech": "node scripts/import-bvtech.js",
    "audit:declaration-overlaps": "node scripts/audit-declaration-value-overlaps.js",
    "audit:zone-agent-permissions": "node scripts/audit-zone-agent-permissions.js",
    "migrate:prisma": "prisma migrate deploy",
    "user:create": "node scripts/create-user.js",
    "lint": "xo",
    "lint:openapi": "spectral lint docs/openapi.yaml",
    "test": "ava",
    "coverage": "c8 ava",
    "coverage:report": "c8 --reporter=html --reporter=text ava",
    "backfill:chunk-actors": "node scripts/backfill-chunk-actors.js",
    "backfill:declarant-activity": "node scripts/backfill-declarant-activity.js",
    "backfill:point-flow-types": "node scripts/backfill-point-flow-types.js",
    "fix:tech-piezometer-zone": "node scripts/fix-tech-piezometer-zone.js",
    "sync:declaration-files": "node scripts/sync-declaration-files.js",
    "import-zone-monitoring-stations": "node scripts/import-zone-monitoring-stations.js",
    "sync:sandre-alert-zones": "node scripts/sync-sandre-alert-zones.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/lib-storage": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@bull-board/ui": "^6.14.2",
    "@etalab/decoupage-administratif": "^5.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.38.0",
    "@sentry/profiling-node": "^10.38.0",
    "bullmq": "^5.63.1",
    "content-disposition": "^0.5.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv-flow": "^4.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "hash-object": "^5.0.1",
    "http-errors": "^2.0.0",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1",
    "lodash-es": "^4.17.21",
    "mjml": "^5.4.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.17.1",
    "proj4": "^2.20.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.11.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "ava": "^6.4.1",
    "baseline-browser-mapping": "^2.9.19",
    "c8": "^10.1.3",
    "dotenv": "^17.2.3",
    "nodemon": "^3.1.11",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "xo": "^1.2.3"
  },
  "c8": {
    "all": true,
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "**/migrations/**",
      "**/scripts/**",
      "**/data/**",
      "**/__tests__/**",
      "lib/util/test-helpers/**"
    ]
  },
  "overrides": {
    "@eslint/plugin-kit": "0.7.2",
    "@hono/node-server": "2.0.6",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">= 24 < 25"
  }
}
