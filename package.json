{
  "name": "prelevement-deau-data",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "node api.js",
    "start-dev": "nodemon --watch './**/*.js' --exec 'node api.js'",
    "start:worker": "node worker.js",
    "migrate:demo": "node scripts/demo/migrate-demo.js",
    "migrate:reunion": "node scripts/reunion/migrate-reunion.js",
    "bootstrap:demo": "node scripts/demo/bootstrap-demo.js",
    "seed:demo": "node scripts/demo/seed-demo.js",
    "import-bvtech": "node scripts/import-bvtech.js",
    "audit:declaration-overlaps": "node scripts/audit-declaration-value-overlaps.js",
    "audit:zone-agent-permissions": "node scripts/audit-zone-agent-permissions.js",
    "benchmark:smart-search": "node scripts/benchmarks/smart-search.js",
    "migrate:prisma": "prisma migrate deploy",
    "user:create": "node scripts/create-user.js",
    "password:activation": "node scripts/create-password-activation.js",
    "lint": "eslint .",
    "lint:openapi": "spectral lint docs/openapi.yaml",
    "check:image-size": "sh deploy/check-image-size.sh",
    "benchmark:search": "node scripts/benchmark-search-performance.js",
    "test": "ava",
    "audit:security": "npm audit --audit-level=low",
    "coverage": "c8 ava",
    "coverage:report": "c8 --reporter=html --reporter=text ava",
    "backfill:chunk-actors": "node scripts/backfill-chunk-actors.js",
    "backfill:declarant-activity": "node scripts/backfill-declarant-activity.js",
    "backfill:point-flow-types": "node scripts/backfill-point-flow-types.js",
    "sync:declaration-files": "node scripts/sync-declaration-files.js",
    "import-zone-monitoring-stations": "node scripts/import-zone-monitoring-stations.js",
    "sync:sandre-alert-zones": "node scripts/sync-sandre-alert-zones.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/lib-storage": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@bull-board/api": "9.10.0",
    "@bull-board/express": "9.10.0",
    "@bull-board/ui": "9.10.0",
    "@etalab/decoupage-administratif": "^6.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.74.0",
    "@sentry/profiling-node": "10.74.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "bullmq": "^6.3.4",
    "compression": "^1.8.1",
    "content-disposition": "^3.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "dotenv-flow": "^4.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hash-object": "^5.1.0",
    "http-errors": "^2.0.1",
    "ioredis": "^6.0.0",
    "joi": "^18.2.8",
    "lodash-es": "^4.18.1",
    "mjml": "^5.4.1",
    "moment": "^2.30.1",
    "mongodb": "^7.6.0",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.3",
    "papaparse": "^5.7.0",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "proj4": "^2.22.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stoplight/spectral-cli": "^6.16.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "ava": "^8.0.1",
    "baseline-browser-mapping": "^2.11.22",
    "bullmq-v5": "npm:bullmq@5.81.5",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-ava": "^17.0.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "c8": {
    "all": true,
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "**/migrations/**",
      "**/scripts/**",
      "**/data/**",
      "**/__tests__/**",
      "lib/util/test-helpers/**"
    ]
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    },
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "@prisma/client@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@sentry/profiling-node@10.74.0": true,
    "@sentry/node-cpu-profiler@2.4.4": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  },
  "engines": {
    "node": ">= 24.21.0 < 25",
    "npm": ">= 11.19.1 < 12"
  }
}
