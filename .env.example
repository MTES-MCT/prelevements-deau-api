# API config
PORT=5000
JSON_BODY_LIMIT=50mb
API_PERF_LOG=0
API_SLOW_REQUEST_MS=1000
API_RESPONSE_COMPRESSION_MIN_BYTES=1024

# PostgreSQL config
DATABASE_URL="postgresql://prelevements-deau:prelevements-deau@localhost:5432/prelevements-deau"
DATABASE_POOL_MAX=5
DATABASE_POOL_SLOW_WAIT_MS=100

# Redis config (required for BullMQ workers - background job processing)
# Install Redis: brew install redis (macOS) or docker run -d -p 6379:6379 redis:alpine
REDIS_URL=redis://localhost:6379
REDIS_TLS_CA_FILE_PATH=

# Cache API optionnel. Utiliser une instance Redis dédiée, distincte de REDIS_URL.
# SEARCH_CACHE_NAMESPACE (ou APP_ENV au runtime) est obligatoire pour l'activer.
SEARCH_CACHE_REDIS_URL=
SEARCH_CACHE_REDIS_TLS_CA_FILE_PATH=
# Valeur explicite propre au déploiement : development, testing ou production.
SEARCH_CACHE_NAMESPACE=
SEARCH_CACHE_REDIS_CONNECT_TIMEOUT_MS=200
SEARCH_CACHE_REDIS_COMMAND_TIMEOUT_MS=150
SEARCH_CACHE_FAILURE_BACKOFF_MS=15000
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_CACHE_MAX_BYTES=5242880

# BullBoard - Dashboard de monitoring des queues (optionnel)
# Accessible sur /admin/queues avec authentification Basic
# Si non défini, BullBoard est désactivé
BULLBOARD_PASSWORD=

# S3 config
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_PREFIX=prelevements-deau-
S3_REGION=fr-par

# Email / SMTP config
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Prélèvements d'eau <noreply@example.com>"

# Brevo transactional emails for declaration reminders/followups
BREVO_API_KEY=
BREVO_TEMPLATE_DECLARATION_REMINDER_WEEK=
BREVO_TEMPLATE_DECLARATION_FOLLOWUP_WEEK=
BREVO_TEMPLATE_DECLARATION_REMINDER_MONTH=
BREVO_TEMPLATE_DECLARATION_FOLLOWUP_MONTH=
DECLARATION_NOTIFICATION_MAX_RECIPIENTS=5000

# Auth config
API_URL=http://localhost:5000
FRONT_URL=http://localhost:3000
AUTH_TOKEN_TTL=3600
SESSION_TOKEN_TTL=2592000
NODE_ENV=development

# Sentry config (optionnel)
SENTRY_DSN=
SENTRY_ENV=

# Orchestration config
ORCHESTRATION_BASE_URL=http://localhost:4000
ORCHESTRATION_WEBHOOK_SECRET=replace_with_real_secret
AUDIT_CONTEXT_SECRET=replace_with_at_least_32_random_bytes

# Référentiel des zones d'alerte SANDRE (SUP/SOU uniquement)
SANDRE_API_BASE_URL=https://services.sandre.eaufrance.fr
SANDRE_REQUEST_TIMEOUT_MS=30000
SANDRE_REQUEST_RETRIES=3
SANDRE_SYNC_CONCURRENCY=4
