enum UserRole {
  DECLARANT
  INSTRUCTOR
  ADMIN
}

enum EmailVerificationPurpose {
  PRIMARY_CHANGE
  ALIAS_ADD
}

enum EmailVerificationStatus {
  PENDING
  SEND_FAILED
  EXPIRED
  VERIFIED
  CANCELLED
  SUPERSEDED
  CONFLICT
}

model User {
  id    String   @id @default(uuid()) @db.Uuid
  email String?  @unique @db.Citext
  role  UserRole

  firstName String?
  lastName  String?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?
  lastLoginAt               DateTime?
  accountCreationMailSentAt DateTime?
  authVersion               Int       @default(0)

  declarant  Declarant?  @relation("UserDeclarant")
  instructor Instructor? @relation("UserInstructor")

  authTokens         AuthToken[]
  sessionTokens      SessionToken[]
  emailAliases       UserEmailAlias[]
  emailVerifications UserEmailVerification[]
  dataExports        DataExport[]

  passwordCredential        PasswordCredential?  @relation("PasswordCredentialOwner")
  passwordActivation        PasswordActivation?  @relation("PasswordActivationOwner")
  passwordActivationsIssued PasswordActivation[] @relation("PasswordActivationIssuer")

  auditEventsAsActor   AuditEvent[] @relation("AuditEventActorUser")
  auditEventsEffective AuditEvent[] @relation("AuditEventEffectiveUser")
  auditEventsAsSubject AuditEvent[] @relation("AuditEventSubjectUser")
}

model UserEmailVerification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose EmailVerificationPurpose
  status  EmailVerificationStatus  @default(PENDING)

  email                String  @db.Citext
  primaryEmailSnapshot String? @db.Citext
  tokenHash            String? @unique @db.Char(64)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastAttemptedAt DateTime
  sentAt          DateTime?
  expiresAt       DateTime
  verifiedAt      DateTime?
  cancelledAt     DateTime?

  @@index([userId])
  @@index([userId, purpose, createdAt])
  @@index([status, expiresAt])
  @@index([email])
}

// Registre interne maintenu par des triggers SQL afin de sérialiser les
// revendications concurrentes d'une même adresse entre plusieurs tables.
model UserEmailIdentity {
  email String @id @db.Citext

  primaryUserId String? @db.Uuid
  aliasUserId   String? @db.Uuid

  verificationUserId    String?                   @db.Uuid
  verificationId        String?                   @unique @db.Uuid
  verificationPurpose   EmailVerificationPurpose?
  verificationExpiresAt DateTime?
}

model UserEmailAlias {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String @unique @db.Citext

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum DeclarantType {
  NATURAL_PERSON
  LEGAL_PERSON
}

enum DeclarantRole {
  PRELEVEUR
  COLLECTEUR
}

enum PreleveurType {
  ICPE
  IRRIGANT
  GESTIONNAIRE_AEP
  AUTRE
}

enum Civility {
  MR
  MRS
}

model Declarant {
  userId String @id @db.Uuid
  user   User   @relation("UserDeclarant", fields: [userId], references: [id], onDelete: Cascade)

  declarations             Declaration[]                     @relation("DeclarationDeclarant")
  declarationsCreated      Declaration[]                     @relation("DeclarationCreatedByDeclarant")
  chunksAsPreleveur        Chunk[]                           @relation("ChunkPreleveur")
  chunksSubmitted          Chunk[]                           @relation("ChunkSubmittedByDeclarant")
  chunksCollected          Chunk[]                           @relation("ChunkCollecteur")
  declarationTypes         DeclarantDeclarationType[]
  pointPrelevements        DeclarantPointPrelevement[]
  collecteurExploitations  DeclarantCollecteurExploitation[] @relation("CollecteurDeclarant")
  serviceAccountDeclarants ServiceAccountDeclarant[]
  serviceAccountTokens     ServiceAccountToken[]
  apiImports               ApiImport[]
  zones                    DeclarantZone[]

  resourceDocuments ResourceDocument[]
  resourceRules     ResourceRule[]
  contactEmails     DeclarantContactEmail[]

  lastDeclarationAt DateTime?

  quickDeclarationEnabled         Boolean @default(true)
  declarationNotificationsEnabled Boolean @default(true)

  declarantType DeclarantType  @default(NATURAL_PERSON)
  declarantRole DeclarantRole  @default(PRELEVEUR)
  preleveurType PreleveurType?

  jobTitle     String? @db.Text
  socialReason String? @db.Text

  civility Civility?

  addressLine1 String? @db.Text
  addressLine2 String? @db.Text
  poBox        String? @db.Text
  postalCode   String? @db.Text
  city         String? @db.Text
  siret        String? @db.Text

  phoneNumber String? @db.Text

  sourceId String? @db.Text

  @@unique([sourceId])
  @@index([declarantRole])
  @@index([quickDeclarationEnabled])
  @@index([declarationNotificationsEnabled])
}

model DeclarantContactEmail {
  id String @id @default(uuid()) @db.Uuid

  declarantUserId String    @db.Uuid
  declarant       Declarant @relation(fields: [declarantUserId], references: [userId], onDelete: Cascade)

  email     String  @db.Citext
  isPrimary Boolean @default(false)
  sourceId  String? @unique @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([declarantUserId, email])
  @@index([declarantUserId])
}

enum DeclarantZoneSource {
  CREATION
  MANUAL
  EXPLOITATION
  DECLARATION
  RECONCILIATION
  MIGRATION
}

model DeclarantZone {
  id String @id @default(uuid()) @db.Uuid

  declarantUserId String    @db.Uuid
  declarant       Declarant @relation(fields: [declarantUserId], references: [userId], onDelete: Cascade)

  zoneId String @db.Uuid
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  source          DeclarantZoneSource @default(MANUAL)
  createdByUserId String?             @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([declarantUserId, zoneId])
  @@index([declarantUserId])
  @@index([zoneId])
  @@index([source])
}

model Instructor {
  userId String @id @db.Uuid
  user   User   @relation("UserInstructor", fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber String? @db.Text
  jobTitle    String? @db.Text

  instructorZones  InstructorZone[]
  instructedChunks Chunk[]

  sourceId String? @db.Text

  @@unique([sourceId])
}

model AuthToken {
  id    String @id @default(uuid()) @db.Uuid
  token String @unique

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authVersion Int @default(0)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model SessionToken {
  id    String @id @default(uuid()) @db.Uuid
  token String @unique

  role UserRole

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedByUserId String?   @db.Uuid
  impersonatedByRole   UserRole?

  authVersion               Int  @default(0)
  impersonatedByAuthVersion Int?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([impersonatedByUserId])
  @@index([expiresAt])
}

model PasswordCredential {
  userId String @id @db.Uuid
  user   User   @relation("PasswordCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)

  passwordHash  String @db.Text
  pepperVersion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordActivation {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.Char(64)

  userId String @unique @db.Uuid
  user   User   @relation("PasswordActivationOwner", fields: [userId], references: [id], onDelete: Cascade)

  createdByUserId String? @db.Uuid
  createdByUser   User?   @relation("PasswordActivationIssuer", fields: [createdByUserId], references: [id], onDelete: SetNull)

  authVersion Int @default(0)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([createdByUserId])
}
