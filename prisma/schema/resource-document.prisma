model ResourceDocument {
  id String @id @default(uuid()) @db.Uuid

  declarantUserId String?    @db.Uuid
  declarant       Declarant? @relation(fields: [declarantUserId], references: [userId], onDelete: Cascade)

  declarantPointPrelevementId String?                    @db.Uuid
  declarantPointPrelevement   DeclarantPointPrelevement? @relation(fields: [declarantPointPrelevementId], references: [id], onDelete: SetNull)

  exploitations ResourceDocumentExploitation[]
  rules         ResourceRule[]

  sourceId      String? @db.Text
  contentSha256 String? @db.Text

  title     String? @db.Text
  reference String? @db.Text
  nature    String? @db.Text
  comment   String? @db.Text

  signatureDate   DateTime? @db.Date
  validityEndDate DateTime? @db.Date

  filename   String  @db.Text
  mimeType   String? @db.Text
  size       Int?
  storageKey String  @unique @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([sourceId])
  @@index([declarantUserId])
  @@index([declarantPointPrelevementId])
  @@index([nature])
  @@index([signatureDate])
  @@index([deletedAt])
}

model ResourceDocumentExploitation {
  id String @id @default(uuid()) @db.Uuid

  resourceDocumentId String           @db.Uuid
  resourceDocument   ResourceDocument @relation(fields: [resourceDocumentId], references: [id], onDelete: Cascade, map: "ResourceDocumentExploitation_documentId_fkey")

  declarantPointPrelevementId String                    @db.Uuid
  declarantPointPrelevement   DeclarantPointPrelevement @relation(fields: [declarantPointPrelevementId], references: [id], onDelete: Cascade, map: "ResourceDocumentExploitation_exploitationId_fkey")

  createdAt DateTime @default(now())

  @@unique([resourceDocumentId, declarantPointPrelevementId], map: "ResourceDocumentExploitation_document_exploitation_key")
  @@index([resourceDocumentId], map: "ResourceDocumentExploitation_documentId_idx")
  @@index([declarantPointPrelevementId], map: "ResourceDocumentExploitation_exploitationId_idx")
}
