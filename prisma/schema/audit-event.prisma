enum AuditOutcome {
  STARTED
  SUCCESS
  DENIED
  FAILURE
  INCOMPLETE
}

enum AuditActorType {
  ANONYMOUS
  USER
  SERVICE_ACCOUNT
}

enum AuditMutationOperation {
  CREATE
  UPDATE
  DELETE
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  occurredAt  DateTime     @default(now())
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt
  outcome     AuditOutcome @default(STARTED)

  actionType     String @db.Text
  actionCategory String @db.Text

  actorType             AuditActorType  @default(ANONYMOUS)
  actorUserId           String?         @db.Uuid
  actorUser             User?           @relation("AuditEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorServiceAccountId String?         @db.Uuid
  actorServiceAccount   ServiceAccount? @relation("AuditEventActorServiceAccount", fields: [actorServiceAccountId], references: [id], onDelete: SetNull)
  actorLabel            String?         @db.Text
  actorEmail            String?         @db.Text
  actorRole             String?         @db.Text

  effectiveUserId    String? @db.Uuid
  effectiveUser      User?   @relation("AuditEventEffectiveUser", fields: [effectiveUserId], references: [id], onDelete: SetNull)
  effectiveUserLabel String? @db.Text
  effectiveUserEmail String? @db.Text
  effectiveUserRole  String? @db.Text

  subjectUserId    String? @db.Uuid
  subjectUser      User?   @relation("AuditEventSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectUserLabel String? @db.Text
  subjectUserEmail String? @db.Text
  subjectUserRole  String? @db.Text

  targetType  String? @db.Text
  targetId    String? @db.Text
  targetLabel String? @db.Text

  requestId       String  @db.Text
  originRequestId String? @db.Text
  httpMethod      String  @db.Text
  route           String  @db.Text
  statusCode      Int?
  clientIp        String? @db.Text
  userAgent       String? @db.Text

  metadata Json @default("{}")

  mutations AuditMutation[]

  @@index([occurredAt])
  @@index([actionType, occurredAt])
  @@index([actionCategory, occurredAt])
  @@index([outcome, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actorServiceAccountId, occurredAt])
  @@index([effectiveUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([targetId, occurredAt])
  @@index([actorLabel(ops: raw("gin_trgm_ops"))], map: "AuditEvent_actorLabel_trgm_idx", type: Gin)
  @@index([actorEmail(ops: raw("gin_trgm_ops"))], map: "AuditEvent_actorEmail_trgm_idx", type: Gin)
  @@index([effectiveUserLabel(ops: raw("gin_trgm_ops"))], map: "AuditEvent_effectiveUserLabel_trgm_idx", type: Gin)
  @@index([effectiveUserEmail(ops: raw("gin_trgm_ops"))], map: "AuditEvent_effectiveUserEmail_trgm_idx", type: Gin)
  @@index([subjectUserLabel(ops: raw("gin_trgm_ops"))], map: "AuditEvent_subjectUserLabel_trgm_idx", type: Gin)
  @@index([subjectUserEmail(ops: raw("gin_trgm_ops"))], map: "AuditEvent_subjectUserEmail_trgm_idx", type: Gin)
  @@index([targetLabel(ops: raw("gin_trgm_ops"))], map: "AuditEvent_targetLabel_trgm_idx", type: Gin)
}

model AuditMutation {
  id           String                 @id @default(uuid()) @db.Uuid
  auditEventId String                 @db.Uuid
  auditEvent   AuditEvent             @relation(fields: [auditEventId], references: [id], onDelete: Cascade)
  occurredAt   DateTime               @default(now())
  operation    AuditMutationOperation

  entityType  String  @db.Text
  entityId    String  @db.Text
  entityLabel String? @db.Text

  before         Json?
  after          Json?
  changedFields  String[] @default([])
  redactedFields String[] @default([])
  metadata       Json     @default("{}")

  scopes AuditMutationScope[]

  @@index([auditEventId])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([entityId, occurredAt(sort: Desc)])
  @@index([operation, occurredAt(sort: Desc)])
  @@index([entityLabel(ops: raw("gin_trgm_ops"))], map: "AuditMutation_entityLabel_trgm_idx", type: Gin)
}

model AuditMutationScope {
  id              String        @id @default(uuid()) @db.Uuid
  auditMutationId String        @db.Uuid
  auditMutation   AuditMutation @relation(fields: [auditMutationId], references: [id], onDelete: Cascade)
  occurredAt      DateTime      @default(now())

  resourceType  String  @db.Text
  resourceId    String  @db.Text
  resourceLabel String? @db.Text

  @@unique([auditMutationId, resourceType, resourceId])
  @@index([auditMutationId])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([resourceId, occurredAt(sort: Desc)])
  @@index([resourceLabel(ops: raw("gin_trgm_ops"))], map: "AuditMutationScope_resourceLabel_trgm_idx", type: Gin)
}
