enum ZoneType {
  REGION
  DEPARTEMENT
  SAGE
}

enum ZoneManagedResourceType {
  SUPERFICIELLE
  SOUTERRAIN
  TRANSITION
  MIXTE
}

model Zone {
  id String @id @default(uuid()) @db.Uuid

  code        String                                     @db.Text
  type        ZoneType
  name        String                                     @db.Text
  coordinates Unsupported("geometry(MultiPolygon,4326)")
  managedResourceType ZoneManagedResourceType?

  instructorZones       InstructorZone[]
  declarantZones        DeclarantZone[]
  collectorPointManagementZones CollectorPointManagementZone[]
  pointPrelevementZones PointPrelevementZone[]
  declarationSettings   ZoneDeclarationSettings?
  declarationOverrides  ZoneDeclarationPeriodOverride[]
  monitoringStations    ZoneMonitoringStation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, code])
  @@index([type])
  @@index([code])
  @@index([coordinates], type: Gist)
}
