enum CollectionCampaignStatus {
  DRAFT
  OPEN
  ARCHIVED
}

model CollectionCampaign {
  id String @id @default(uuid()) @db.Uuid
  sourceId String? @unique
  name String
  type String @default("DROPT_INDEX_NEEDS_2026_2027")
  status CollectionCampaignStatus @default(DRAFT)
  opensOn DateTime? @db.Date
  closesOn DateTime? @db.Date
  closedAt DateTime?
  collecteurUserId String @db.Uuid
  collecteur Declarant @relation("CollectionCampaignCollector", fields: [collecteurUserId], references: [userId], onDelete: Restrict)
  createdByUserId String @db.Uuid
  createdBy User @relation("CollectionCampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responses CollectionResponse[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collecteurUserId, status])
}

model CollectionResponse {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign CollectionCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  exploitationId String @db.Uuid
  exploitation DeclarantPointPrelevement @relation(fields: [exploitationId], references: [id], onDelete: Restrict)
  preleveurUserId String @db.Uuid
  preleveur Declarant @relation("CollectionResponsePreleveur", fields: [preleveurUserId], references: [userId], onDelete: Restrict)
  draftData Json?
  submittedData Json?
  submittedHash String?
  revision Int @default(0)
  firstSubmittedAt DateTime?
  lastSubmittedAt DateTime?
  declarationId String? @unique @db.Uuid
  declaration Declaration? @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  publicationStatus String @default("NOT_SUBMITTED")
  publicationIssues Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, exploitationId])
  @@index([preleveurUserId, campaignId])
}
