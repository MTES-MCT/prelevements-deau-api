model Declaration {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(6)

  // Déclarant métier : le préleveur pour lequel les volumes sont déclarés.
  declarantUserId String    @db.Uuid
  declarant       Declarant @relation("DeclarationDeclarant", fields: [declarantUserId], references: [userId], onDelete: Cascade)

  // Auteur technique : le compte qui a déposé la déclaration.
  // Il est différent de declarantUserId lorsqu'un collecteur déclare pour un préleveur.
  createdByDeclarantUserId String?    @db.Uuid
  createdByDeclarant       Declarant? @relation("DeclarationCreatedByDeclarant", fields: [createdByDeclarantUserId], references: [userId], onDelete: SetNull)

  // Fichiers liés
  files DeclarationFile[]

  // Validation automatique
  autoValidationEnabled Boolean @default(false)

  // Sources
  source Source? @relation

  // Métadonnées
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  importSourceId String?  @db.Text

  // Champs métier
  type                String                     @db.Text
  comment             String?                    @db.Text
  aotDecreeNumber     String?
  dataSourceType      DeclarationDataSourceType?
  waterWithdrawalType String
  consolidatedAt      DateTime?

  processingStatus       DeclarationProcessingStatus  @default(CREATED)
  processingJobId        String?                      @db.Text
  processingAttemptCount Int                          @default(0)
  processingQueuedAt     DateTime?
  processingStartedAt    DateTime?
  processingCompletedAt  DateTime?
  processingFailedAt     DateTime?
  processingError        String?                      @db.Text
  processingEvents       DeclarationProcessingEvent[]

  @@unique([importSourceId])
  @@index([declarantUserId])
  @@index([createdByDeclarantUserId])
  @@index([dataSourceType])
  @@index([waterWithdrawalType])
  @@index([consolidatedAt])
  @@index([processingStatus])
  @@index([processingQueuedAt])
  @@index([createdAt, id])
}

enum DeclarationDataSourceType {
  NONE
  MANUAL
  SPREADSHEET
  API
}

enum DeclarationProcessingStatus {
  CREATED
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model DeclarationProcessingEvent {
  id String @id @default(uuid()) @db.Uuid

  declarationId String      @db.Uuid
  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  status   DeclarationProcessingStatus
  message  String?                     @db.Text
  metadata Json?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([declarationId])
  @@index([status])
  @@index([createdAt])
}

model DeclarationFile {
  id String @id @default(uuid()) @db.Uuid

  declarationId String      @db.Uuid
  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  type     String
  filename String

  storageKey String

  createdAt DateTime @default(now())

  @@unique([storageKey])
  @@index([declarationId])
  @@index([type])
}

model DeclarationType {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.Text
  name        String  @db.Text
  version     Int     @default(1)
  isAvailable Boolean @default(true)

  declarants DeclarantDeclarationType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isAvailable])
}

model DeclarantDeclarationType {
  id String @id @default(uuid()) @db.Uuid

  declarantUserId String    @db.Uuid
  declarant       Declarant @relation(fields: [declarantUserId], references: [userId], onDelete: Cascade)

  declarationTypeId String          @db.Uuid
  declarationType   DeclarationType @relation(fields: [declarationTypeId], references: [id], onDelete: Cascade)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([declarantUserId, declarationTypeId, startDate])
  @@index([declarantUserId])
  @@index([declarationTypeId])
  @@index([startDate])
  @@index([endDate])
}
