enum WaterUseKind {
  USAGE
  SUB_USAGE
}

model SandreWaterUse {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(16)

  kind WaterUseKind

  parentId String?          @db.Uuid
  parent   SandreWaterUse?  @relation("SandreWaterUseChildren", fields: [parentId], references: [id])
  children SandreWaterUse[] @relation("SandreWaterUseChildren")

  mnemonic   String? @db.Text
  label      String  @db.Text
  definition String? @db.Text
  status     String? @db.Text

  color            String  @default("#6A6A6A") @db.VarChar(7)
  dashboardVisible Boolean @default(true)

  sourceUpdatedAt            DateTime?
  createdAt                  DateTime                                  @default(now())
  updatedAt                  DateTime                                  @updatedAt
  exploitations              DeclarantPointPrelevement[]
  secondaryExploitationLinks DeclarantPointPrelevementSecondaryUsage[]
  chunks                     Chunk[]

  @@index([kind])
  @@index([parentId])
  @@index([dashboardVisible])
}
